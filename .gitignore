# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.cpython-*.pyc
*.pyo
*.pyd
*.so

# Виртуальные окружения
venv/
.venv/
env/
.env/

# Переменные окружения (содержат пароли)
.env
.env.*
!.env.example

# Дистрибутивы и сборки
dist/
build/
*.egg-info/
*.egg

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# mypy / pyright
.mypy_cache/
.pyright/

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.*
!frontend/.env.example

# Логи npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── IDE и редакторы ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ─── Прочее ──────────────────────────────────────────────────────────────────
*.log
*.sqlite3
*.db
